# ─── MTN MoMo Uganda ─────────────────────────────────────────────────────────
# Register at: https://momodeveloper.mtn.com
# Callback URL to give MTN: https://itabproperties.com/api/payments/mtn/callback
#
# How to get credentials:
# 1. Sign up at https://momodeveloper.mtn.com
# 2. Subscribe to "Collection" product → copy MTN_SUBSCRIPTION_KEY
# 3. Go to Collection sandbox → Generate API User → copy MTN_API_USER
# 4. Generate API Key for that user → copy MTN_API_KEY
# 5. Change MTN_ENVIRONMENT to 'production' when going live
#
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_API_USER=your_mtn_api_user
MTN_API_KEY=your_mtn_api_key
MTN_ENVIRONMENT=sandbox

# ─── Airtel Money Uganda ──────────────────────────────────────────────────────
# Register at: https://developers.airtel.africa
# Callback URL to give Airtel: https://itabproperties.com/api/payments/airtel/callback
#
# How to get credentials:
# 1. Sign up at https://developers.airtel.africa/user/signup
# 2. Create an app → copy AIRTEL_CLIENT_ID and AIRTEL_CLIENT_SECRET
# 3. Airtel Uganda will whitelist your callback URL
# 4. Change AIRTEL_ENVIRONMENT to 'production' when going live
#
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_ENVIRONMENT=sandbox
