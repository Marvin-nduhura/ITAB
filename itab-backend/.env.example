PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/itab_db
JWT_SECRET=your_super_secret_jwt_key_change_this
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# MTN MoMo (get from https://momodeveloper.mtn.com)
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_API_USER=your_mtn_api_user
MTN_API_KEY=your_mtn_api_key
MTN_ENVIRONMENT=sandbox

# Airtel Money (get from https://developers.airtel.ug)
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_ENVIRONMENT=sandbox
